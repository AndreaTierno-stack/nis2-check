<div data-testid="outcome" data-outcome="likely_in_scope" data-mode="categorical_assessment">
<div>
<h1>Esito del pre-screening</h1>
<ol aria-label="Esito del pre-screening">
<li>Probabile esclusione</li>
<li>Esito incerto</li>
<li aria-current="true">Probabile rientro</li>
