exports[`question screen > renders the visible question with its corpus label, help and options 1`] = `
"<div data-testid="question" data-question="registrato_pun">
<p>Domanda 6 di 9</p>
<fieldset>
<legend>Il soggetto è obbligato a registrarsi sul PUN (Piattaforma Unica Nazionale) come gestore di punti di ricarica, ai sensi del DM MASE n. 106 del 16/03/2023?</legend>
<p>Secondo la FAQ ACN A1.1.a.3 rientrano nella definizione della tipologia
«gestore di un punto di ricarica» solo i soggetti obbligati a registrarsi
sul PUN (art. 5 del DM MASE n. 106/2023); i punti vendita che offrono
ricarica senza questo obbligo non rientrano nella definizione.</p>
<div role="radiogroup">
<label data-option="si">
<input type="radio" name="registrato_pun" value="si"/>
<span>Sì, registrato o obbligato alla registrazione su PUN</span>
</label>
<label data-option="no">
<input type="radio" name="registrato_pun" value="no"/>
<span>No, non obbligato alla registrazione su PUN</span>
</label>
<label data-option="non_so">
<input type="radio" name="registrato_pun" value="non_so"/>
<span>Non so</span>
</label>
</div>
</fieldset>
<div>
<button>Indietro</button>
<button disabled="" data-testid="next">Avanti</button>
</div>
</div>"
`;

