{
  "name": "nis2-check",
  "private": true,
  "description": "Pre-screening informativo dell'ambito NIS2 italiano — monorepo (web, engine, corpus).",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "corpus:validate": "pnpm --filter @nis2-check/corpus corpus:validate",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "engine:enumerate": "pnpm --filter @nis2-check/engine enumerate"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreCves": [
        "CVE-2023-54404",
        "CVE-2026-41305",
        "CVE-2026-45623",
        "CVE-2026-69153",
        "CVE-2026-73646",
        "CVE-2026-118764"
      ]
    }
  }
}
